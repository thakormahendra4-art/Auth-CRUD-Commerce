# Server Configuration
PORT=3000

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017/authentication
# For MongoDB Atlas in production:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Security Secrets (Use strong random strings)
ACCESS_TOKEN_SECRET=replace_with_strong_access_token_secret_hash_key_12345
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_token_secret_hash_key_67890

# ImageKit CDN Integration (Optional for product image upload)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
